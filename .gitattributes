*.bats   text eol=lf
*.bash   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.R      text eol=lf

## Cheatsheet sources are text; its rendered output is not.
*.qmd    text eol=lf
*.typ    text eol=lf
*.pdf    binary
