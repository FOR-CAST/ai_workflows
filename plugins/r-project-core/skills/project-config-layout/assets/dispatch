#!/usr/bin/env bash
## Git hook dispatcher, installed for all of a user's repositories by scripts/git-hooks/install.sh
## (one link per hook name in ~/.githooks, with core.hooksPath pointing there). A repository that
## sets its own core.hooksPath bypasses it.
##
## pre-commit and pre-merge-commit refuse a staged private key or Google service-account key,
## however it was staged: `git add -f`, a renamed or moved copy, or a changed .gitignore.
## pre-push refuses to publish a commit that adds one, however the commit arrived: a fast-forward
## merge, a cherry-pick, a rebase, or a commit made with --no-verify. Bypass a false positive with
## `git commit --no-verify` or `git push --no-verify`.
##
## Every hook then runs the repository's own hook of the same name, if it has one, because a global
## core.hooksPath would otherwise skip it (git-lfs, for example, installs per-repository hooks).
## No pipefail: `grep -q` stops at the first match and the writer then dies of SIGPIPE, which
## pipefail would turn into "no match" for any file larger than the pipe buffer.
set -u

hook=${0##*/}

## PEM and PGP private keys, ssh.com keys ([K] keeps this line from matching itself) and Google
## service-account keys; PuTTY keys by their first line
key_re='-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----|---- BEGIN SSH2 ENCRYPTED PRIVATE [K]EY ----|"type"[[:space:]]*:[[:space:]]*"service_account"'
putty_re='^PuTTY-User-Key-File-[0-9]+:'

if [ "$hook" = "pre-commit" ] || [ "$hook" = "pre-merge-commit" ]; then
  status=0
  while IFS= read -r -d '' f; do
    ## ":0:" names the staged copy explicitly; a bare ":$f" misreads paths such as "1:notes"
    if git cat-file -p ":0:$f" 2>/dev/null | grep -Eq -e "$key_re" -e "$putty_re"; then
      echo "$hook: refusing to commit '$f': it holds a private key or a service-account key." >&2
      status=1
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMRT -z)
  [ "$status" -eq 0 ] || exit "$status"
fi

if [ "$hook" = "pre-push" ]; then
  ## git's ref lines, read once: the repository's own pre-push (git-lfs, for one) reads them too
  refs="$(
    cat
    printf x
  )"
  refs="${refs%x}"
  status=0
  while read -r local_ref local_sha _ remote_sha; do
    ## a deletion (all-zero local sha) publishes nothing
    case "${local_sha:-0}" in *[!0]*) ;; *) continue ;; esac
    ## what this push publishes: commits the remote's tracking refs do not reach, nor the commit
    ## the remote ref holds now (a force-push or a push to a URL has no tracking ref)
    not=(--not)
    [ -n "${1:-}" ] && not+=("--remotes=$1")
    case "${remote_sha:-0}" in
      *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && not+=("$remote_sha") ;;
    esac
    ## every line those commits add, merges included (-m) and binary files as text, in one pass.
    ## No external diff or textconv, so no configured command runs. awk reads to the end, so git
    ## never meets a closed pipe, and git's own status is kept: a failed scan refuses the push.
    out="$(
      git -c core.quotePath=false log -p -m --text -U0 --no-renames --no-ext-diff --no-textconv \
        --no-color --no-show-signature --src-prefix=a/ --dst-prefix=b/ --format='commit %H' \
        "$local_sha" "${not[@]}" 2>/dev/null |
        awk -v key="$key_re" -v putty="$putty_re" '
          /^commit / { c = substr($2, 1, 12); next }
          /^\+\+\+ / { f = substr($0, 7); next }
          /^\+/ { l = substr($0, 2); if (l ~ key || l ~ putty) print c " " f }'
      echo "status=${PIPESTATUS[0]}"
    )"
    if [ "${out##*status=}" != 0 ]; then
      echo "pre-push: could not check $local_ref for keys, so it is not pushed." >&2
      status=1
      continue
    fi
    while read -r c f; do
      [ -z "$c" ] && continue
      echo "pre-push: refusing to push $local_ref: commit $c adds a private key or a service-account key in '$f'." >&2
      status=1
    done <<<"$(printf '%s' "${out%status=*}" | sort -u)"
  done <<<"$refs"
  if [ "$status" -ne 0 ]; then
    echo "pre-push: take the key out of those commits (amend or rebase), then push again." >&2
    exit "$status"
  fi
fi

## outside a repository (a hook run while one is being created) there is nothing to chain to
common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
repo_hook="$common_dir/hooks/$hook"
if [ -x "$repo_hook" ] && [ "$(readlink -f "$repo_hook")" != "$(readlink -f "$0")" ]; then
  if [ "$hook" = "pre-push" ]; then
    ## the scan above consumed git's ref lines; hand them on unchanged
    printf '%s' "$refs" | "$repo_hook" ${1+"$@"}
    exit $?
  fi
  exec "$repo_hook" ${1+"$@"}
fi
exit 0
